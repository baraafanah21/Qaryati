{
  "name": "qaryati",
  "version": "0.1.0",
  "description": "API-only backend for sourced, verifiable knowledge about Palestinian villages",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src test/reference-module --config .dependency-cruiser.cjs",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --coverage",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:drift": "scripts/check-schema-drift.sh",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node -r ts-node/register/transpile-only src/seed/dev/run-dev-seed.ts",
    "db:seed:perf": "node -r ts-node/register/transpile-only src/seed/perf/run-perf-seed.ts",
    "openapi:generate": "node -r ts-node/register/transpile-only src/generate-openapi.ts",
    "openapi:check": "scripts/check-openapi-drift.sh",
    "perf:up": "scripts/perf/up.sh",
    "perf:read": "scripts/perf/run-k6.sh read-heavy",
    "perf:write": "scripts/perf/run-k6.sh write-heavy",
    "perf:ratelimit": "scripts/perf/run-k6.sh rate-limit-check",
    "perf:statements": "scripts/perf/top-statements.sh",
    "perf:inspect": "for s in read-heavy write-heavy rate-limit-check; do docker run --rm -v \"$PWD/perf:/perf:ro\" grafana/k6:2.4.0@sha256:d41bb79cd8de5a7ad619b53570e3712633e8bff0937010a5c6c57a4747e7a276 inspect /perf/$s.js >/dev/null || exit 1; done && echo k6 inspect: ok",
    "keys:dev": "node scripts/generate-dev-jwt-keys.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "4.0.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.8.0",
    "argon2": "0.45.1",
    "cockatiel": "4.0.0",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "ioredis": "6.1.0",
    "jose": "6.2.14",
    "lru-cache": "11.2.2",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "nock": "15.0.6",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
