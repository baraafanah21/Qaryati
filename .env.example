# Copy to .env (never commit .env). Every variable is explained in
# docs/configuration.md. Values here are for local development only.
# Passwords are used inside URLs below: keep them to letters, digits, - and _.

# --- Docker Compose: database container ---------------------------------------
# Owner role: owns the database, runs migrations. Created by the postgres image.
POSTGRES_USER=qaryati_owner
POSTGRES_PASSWORD=owner-dev-password
POSTGRES_DB=qaryati
# Password of the restricted runtime role qaryati_app (created by docker/postgres/init).
APP_DB_PASSWORD=app-dev-password

# --- Docker Compose: ports published on 127.0.0.1 ---------------------------
# Change one if the port is already taken on your machine.
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=3000

# --- API (npm run start:dev on the host; Compose sets its own values) --------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent. Also passed to the api container.
LOG_LEVEL=info
# Runtime role qaryati_app. Must match APP_DB_PASSWORD, POSTGRES_DB and DB_HOST_PORT.
DATABASE_URL=postgres://qaryati_app:app-dev-password@localhost:5432/qaryati
# Generate these files locally; never commit key material. Compose mounts the same files as secrets.
JWT_PRIVATE_KEY_FILE=secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=secrets/jwt-public.pem
JWT_ISSUER=qaryati
# Positive integer duration followed by s, m or h; login expiresIn is in seconds.
JWT_ACCESS_TTL=15m
# Refresh-token lifetime: positive integer followed by s, m, h or d.
JWT_REFRESH_TTL=7d
# Seconds each API process caches administrative units (reference data). Integer >= 1.
ADMIN_UNITS_CACHE_TTL_SECONDS=3600
# Seconds each API process caches products (reference data). Integer >= 1.
PRODUCTS_CACHE_TTL_SECONDS=3600
# Swagger UI at /api/docs and /api/docs-json. For local development only:
# an explicit value wins over NODE_ENV, so never set true in production.
# Unset = on, except when NODE_ENV=production.
SWAGGER_ENABLED=true

# --- Security and operations (#25, #42, #43) ---------------------------------
# Redis for rate-limit counters. Compose sets redis://redis:6379 for the container.
REDIS_URL=redis://localhost:6379
# Rate limits per minute (anonymous per IP, authenticated per user, login per IP + email).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Comma-separated browser origins allowed by CORS; empty = none. The web client's dev origin:
CORS_ORIGINS=http://localhost:5173
# Express trust proxy: false, a hop count (1 behind one reverse proxy) or trusted addresses.
TRUST_PROXY=false
# Internal port of GET /metrics (Prometheus). Not published by Compose.
METRICS_PORT=9464

# --- Geocoding (geo module) ---------------------------------------------------
# stub (no network; default for development, tests, CI and k6) or nominatim.
GEO_PROVIDER=stub
# Base URL of the Nominatim API, without /search.
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Required with GEO_PROVIDER=nominatim (Nominatim usage policy). A project
# identifier, never a personal email address.
GEO_USER_AGENT=Qaryati/1.0 (university project)
# Time limit of one geocoding attempt, in milliseconds (100-60000).
GEO_TIMEOUT_MS=5000
# Resilience: retries only on timeouts, network errors and 502/503/504.
GEO_RETRY_BASE_MS=200
GEO_BREAKER_THRESHOLD=5
GEO_BREAKER_HALF_OPEN_MS=30000
# Nominatim rate limit (1 request per second) and how long a caller may queue.
GEO_MIN_INTERVAL_MS=1000
GEO_QUEUE_TIMEOUT_MS=5000
# Redis cache of geocoding results: 30 days, empty results 24 hours.
GEO_CACHE_TTL_SECONDS=2592000
GEO_CACHE_EMPTY_TTL_SECONDS=86400

# --- Migrations (npm run db:migrate | db:generate | db:check | db:studio) -----
# Owner role. Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB and DB_HOST_PORT.
DATABASE_OWNER_URL=postgres://qaryati_owner:owner-dev-password@localhost:5432/qaryati
