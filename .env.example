# Copy to .env (never commit .env). Every variable is explained in
# docs/configuration.md. Values here are for local development only.
# Passwords are used inside URLs below: keep them to letters, digits, - and _.

# --- Docker Compose: database container ---------------------------------------
# Owner role: owns the database, runs migrations. Created by the postgres image.
POSTGRES_USER=qaryati_owner
POSTGRES_PASSWORD=owner-dev-password
POSTGRES_DB=qaryati
# Password of the restricted runtime role qaryati_app (created by docker/postgres/init).
APP_DB_PASSWORD=app-dev-password

# --- Docker Compose: ports published on 127.0.0.1 ---------------------------
# Change one if the port is already taken on your machine.
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=3000

# --- API (npm run start:dev on the host; Compose sets its own values) --------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent. Also passed to the api container.
LOG_LEVEL=info
# Runtime role qaryati_app. Must match APP_DB_PASSWORD, POSTGRES_DB and DB_HOST_PORT.
DATABASE_URL=postgres://qaryati_app:app-dev-password@localhost:5432/qaryati
# Generate these files locally; never commit key material. Compose mounts the same files as secrets.
JWT_PRIVATE_KEY_FILE=secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=secrets/jwt-public.pem
JWT_ISSUER=qaryati
# Swagger UI at /api/docs and /api/docs-json. For local development only:
# an explicit value wins over NODE_ENV, so never set true in production.
# Unset = on, except when NODE_ENV=production.
SWAGGER_ENABLED=true

# --- Migrations (npm run db:migrate | db:generate | db:check | db:studio) -----
# Owner role. Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB and DB_HOST_PORT.
DATABASE_OWNER_URL=postgres://qaryati_owner:owner-dev-password@localhost:5432/qaryati
